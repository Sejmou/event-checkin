# Drizzle
DATABASE_URL=local.db

# Public base URL. The QR code on the check-in screen points here, so it must be
# reachable from attendees' phones — and HTTPS, or passkeys will not work.
ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Passkeys (WebAuthn). Must match the hostname in the browser address bar, with
# no scheme and no port. Changing it invalidates every passkey already registered.
PASSKEY_RP_ID="localhost"
